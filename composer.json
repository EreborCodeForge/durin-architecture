{
    "name": "ereborcodeforge/durin-architecture",
    "description": "Architecture detection, drift and migration planning for Durin projects.",
    "type": "library",
    "license": "MIT",
    "version": "0.1.4",
    "authors": [
        {
            "name": "Thales Ruppenthal",
            "email": "thales.rup@gmail.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "ereborcodeforge/durin-core": "^0.1 || ^0.2",
        "ereborcodeforge/durin-presets": "^0.1 || ^0.2 || ^0.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../durin-core",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../durin-presets",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "EreborCodeForge\\Durin\\Architecture\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EreborCodeForge\\Durin\\Architecture\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
